SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1
POSTGRES_DB=transcendence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by the backend when running outside Docker. Compose overrides it with db.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# OAuth is optional for email/password login. Never commit the real secret.
GOOGLE_OAUTH_CLIENT_ID=71882428382-1inid49vhqdp6hj8arht8utjq5jrdo30.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=example-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://localhost/api/auth/google/callback/
# Keep this URL without a trailing slash; the callback appends its own path.
FRONTEND_URL=https://localhost

GEO_PROVIDER=auto
MAPTILER_API_KEY=
MAPTILER_LIGHT_MAP_ID=dataviz-v4-light
MAPTILER_DARK_MAP_ID=dataviz-dark
GEOAPIFY_API_KEY=
NOMINATIM_USER_AGENT=ft-transcendence/1.0
GEO_CACHE_TTL_DAYS=30
GEO_DEBUG=False
PUBLIC_API_RATE=60/minute
PUBLIC_API_IP_RATE=120/minute

# Values used by the production frontend image. Local Vite can keep its own
# frontend/.env with http://127.0.0.1 endpoints when running outside Docker.
VITE_API_URL=https://localhost
VITE_WS_URL=wss://localhost

# Set to 1 to start an empty database instead of loading the eval snapshot.
NO_SEED=0
